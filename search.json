---
layout: null
---
[
{% for post in site.posts %}
    {
        "title": {{ post.title | jsonify }},
        "url": {{ post.url | prepend: site.baseurl | prepend: site.url | jsonify }},
        "date": {{ post.date | date: "%Y-%m-%d" | jsonify }},
        "tags": {{ post.tags | jsonify }},
        "author": {{ post.author | default: site.title | jsonify }},
        "subtitle": {{ post.subtitle | default: "" | jsonify }},
        "excerpt": {{ post.content | strip_html | strip_newlines | truncate: 200 | jsonify }}
    }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
