{
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "zola serve",
    "dev:all": "concurrently -k -n zola,ts,uno -c blue,magenta,green \"pnpm dev\" \"pnpm dev:vite\" \"pnpm dev:unocss\"",
    "build": "zola build",
    "build:all": "pnpm run build:vite && pnpm run build:unocss && pnpm run build:subset-titlefont && pnpm run build && pnpm run build:rewrite-imgs",
    "build:vite": "vite build",
    "dev:vite": "vite build --watch",
    "preview": "vite preview ./public",
    "typecheck": "tsc --noEmit",
    "build:subset-titlefont": "cargo run --bin title-font-subset -- --content-dir content --font static/fonts/SourceHanSerifCN-VF.ttf --font-output-dir static/fonts --css-output-dir static/styles --css-file source-han-serif-title.css --font-family \"Hibikilogy Title Serif\" --output-file source-han-serif-title.woff2",
    "build:rewrite-imgs": "cargo run --bin html-img-host-rewrite -- --config config.toml ./public",
    "check:legacy-links": "cargo run --bin fix-legacy-article-links -- --content-dir content",
    "dev:unocss": "unocss \"{templates,content}/**/*.{html,md,js}\" --watch -o static/styles/uno.css",
    "build:unocss": "unocss \"{templates,content}/**/*.{html,md,js}\" -o static/styles/uno.css",
    "fix:legacy-links": "cargo run --bin fix-legacy-article-links -- --content-dir content --write",
    "lint": "zola check",
    "lint:zh": "npx zhlint content/**/*.md",
    "lint:eslint": "eslint --cache .",
    "lint:eslint:fix": "eslint --cache --fix .",
    "preinstall": "npx only-allow pnpm"
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.9.0",
    "@swup/body-class-plugin": "^3.3.0",
    "@swup/ga-plugin": "^2.0.0",
    "@swup/head-plugin": "^2.3.1",
    "@swup/scroll-plugin": "^4.0.0",
    "clsx": "^2.1.1",
    "fuse.js": "^7.4.2",
    "katex": "^0.17.0",
    "lit": "^3.2.1",
    "medium-zoom": "1.1.0",
    "petite-vue": "^0.4.1",
    "swup": "^4.9.2",
    "tailwind-merge": "^3.6.0",
    "thumbhash": "^0.1.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@types/node": "^25.9.3",
    "@unocss/cli": "^66.7.2",
    "@unocss/eslint-plugin": "^66.7.2",
    "@unocss/preset-wind4": "^66.7.2",
    "concurrently": "^10.0.3",
    "eslint": "^10.3.0",
    "typescript": "^6.0.0",
    "unocss": "^66.7.2",
    "vite": "^8.0.0"
  }
}
